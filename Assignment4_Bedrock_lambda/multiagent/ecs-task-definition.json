{
  "family": "multiagent-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::491884381643:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::491884381643:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "multiagent",
      "image": "491884381643.dkr.ecr.us-east-1.amazonaws.com/bedrock-agentcore-krishi:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "MODEL_ID",
          "value": "amazon.nova-lite-v1:0"
        },
        {
          "name": "UAT_DOCUMENT_DIRECTORY",
          "value": "/app/uat_documents"
        },
        {
          "name": "LOG_LEVEL",
          "value": "INFO"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/multiagent",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
